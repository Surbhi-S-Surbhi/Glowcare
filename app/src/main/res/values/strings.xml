    <!-- Privacy -->
    <string name="privacy_intro">Your photos and data belong to you. Here is exactly how GlowCare handles them.</string>
    <string name="privacy_camera_title">Camera use</string>
    <string name="privacy_camera_body">The camera permission is requested only when you open the Camera tab, and is used only to take and preview photos inside the app. Denying it never blocks any other feature — you can always import from your gallery instead.</string>
    <string name="privacy_photos_title">Photos stay on your device</string>
    <string name="privacy_photos_body">All filters, beauty effects and edits are processed locally on your phone. Photos are never uploaded to any server. Photos only leave your device if you explicitly tap Share.</string>
    <string name="privacy_minimal_title">Minimal data</string>
    <string name="privacy_minimal_body">GlowCare stores your interests, progress and reminder time only, on your device (local storage). No tracking, no unnecessary personal information.</string>
    <string name="privacy_control_title">You are in control</string>
    <string name="privacy_control_body">You can delete everything — progress, saved tips and settings — anytime from Profile → Reset all data. Removing the app also removes all local data.</string>
    <string name="privacy_account_title">Google account</string>
    <string name="privacy_account_body">If you sign in with Google, GlowCare receives only your name and email from Google Sign-In to remember your profile. We never see your password and never post anything on your behalf.</string>
    <string name="privacy_billing_title">Subscriptions</string>
    <string name="privacy_billing_body">Premium is a Google Play subscription. Billing, trials and cancellations are handled entirely by Google Play — GlowCare only checks whether your subscription is active. No card details ever reach the app.</string>
    <string name="privacy_permissions_title">Permissions, when needed</string>
    <string name="privacy_permissions_body">Camera: only when you open the beauty camera.\nMicrophone: only when you record video with sound.\nGallery access uses Android\'s private photo picker — you choose the exact photo, and no broad gallery permission is ever requested.</string>

